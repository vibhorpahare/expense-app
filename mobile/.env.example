# iOS Simulator (shares the Mac's localhost) -- default, works with zero config
EXPO_PUBLIC_API_URL=http://localhost:8000

# Android emulator instead: EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Expo Go on a physical phone (same Wi-Fi as this machine):
#   run `ipconfig getifaddr en0` on macOS to get your LAN IP, then:
#   EXPO_PUBLIC_API_URL=http://<lan-ip>:8000
